# Copy to .env and fill in. Only EXPO_PUBLIC_* vars are exposed to the client bundle.

# Point at your live backend. Swap to a Cloudflare tunnel / LAN IP for local backend dev.
EXPO_PUBLIC_API_URL=https://api.goalgoalpredict.com/api
# Web app origin — used to build shareable invite links (/invite/CODE).
EXPO_PUBLIC_WEB_URL=https://goalgoalpredict.com
